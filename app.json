{
  "expo": {
    "name": "Mero Snake",
    "slug": "mero-snake",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "merosnake",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0C12",
    "ios": {
      "bundleIdentifier": "com.laakhey.merosnake",
      "supportsTablet": true
    },
    "android": {
      "package": "com.laakhey.merosnake",
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0C12",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-audio",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
