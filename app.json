{
  "expo": {
    "name": "Mero Snake",
    "slug": "mero-snake",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "merosnake",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0C12",
    "ios": {
      "bundleIdentifier": "com.laakhey.merosnake",
      "supportsTablet": true
    },
    "android": {
      "package": "com.laakhey.merosnake",
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0C12",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "9c4a36c9-2553-4cec-9018-8f7251dd467f"
      }
    },
    "owner": "laakhey",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9c4a36c9-2553-4cec-9018-8f7251dd467f"
    }
  }
}
